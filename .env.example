# Configure estas variáveis no painel do projeto na Vercel
# (Settings → Environment Variables) — nunca num arquivo commitado.
# Este arquivo é só documentação; não tem segredo nenhum dentro dele.

GEMINI_API_KEY=

# Nome do modelo de visão do Gemini a usar (ex.: gemini-2.5-flash).
# Compartilhado pela fase 06 (leitura semântica) e pela fase 14
# (verificação cega) — as duas são LEITURA de imagem, não geração, então
# usam o mesmo modelo multimodal de texto+visão.
# CONFIRME o valor certo no Google AI Studio / painel de faturamento da
# conta paga antes de configurar em produção — o valor padrão embutido em
# api/leitura-semantica.js e api/verificar-imagem.js não foi verificado
# (rede sem acesso a domínios do Google no ambiente onde este projeto foi
# escrito).
GEMINI_MODEL=

# Nome do modelo de IMAGEM do Gemini a usar (ex.: gemini-2.5-flash-image).
# Mesma ressalva do GEMINI_MODEL acima, para a fase 13 (geração das
# imagens) — o valor padrão embutido em api/gerar-imagem.js não foi
# verificado. CONFIRME antes de configurar em produção.
GEMINI_IMAGE_MODEL=
