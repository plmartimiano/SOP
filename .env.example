# Configure estas variáveis no painel do projeto na Vercel
# (Settings → Environment Variables) — nunca num arquivo commitado.
# Este arquivo é só documentação; não tem segredo nenhum dentro dele.

# ATUALIZADO em 2026-08-29 (cartão de handoff): o cliente usa Gemini via
# VERTEX AI (projeto do Google Cloud + conta de serviço), não a Gemini
# Developer API com uma chave simples — por isso não existe mais uma
# variável "GEMINI_API_KEY" única. Ver api/_auth-vertex.js para o porquê
# e o fluxo de autenticação completo.

# Conteúdo INTEIRO do arquivo JSON da conta de serviço (Google Cloud
# Console → IAM e administrador → Contas de serviço → (a conta certa) →
# Chaves → Adicionar chave → Criar nova chave → JSON — baixa um arquivo).
# Cole o arquivo INTEIRO aqui, sem editar nada dentro dele (o private_key
# já vem com as quebras de linha escapadas como texto "\n", que o
# JSON.parse do lado do servidor resolve sozinho).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID do projeto do Google Cloud do cliente (o mesmo PROJECT_ID que já
# aparece no snippet Python que o cliente usa hoje:
# genai.Client(vertexai=True, project=PROJECT_ID, location="global")).
GOOGLE_CLOUD_PROJECT=

# Região do Vertex AI. O cliente confirmou "global" (mesmo snippet acima)
# — deixe em branco para usar "global" como padrão, ou informe uma região
# específica (ex.: us-central1) se precisar trocar depois.
GOOGLE_CLOUD_LOCATION=

# Nome do modelo de visão do Gemini a usar (ex.: gemini-2.5-flash).
# Compartilhado pela fase 06 (leitura semântica) e pela fase 14
# (verificação cega) — as duas são LEITURA de imagem, não geração, então
# usam o mesmo modelo multimodal de texto+visão.
# CONFIRME o valor certo no console do Vertex AI / Model Garden da conta
# do cliente antes de configurar em produção — o valor padrão embutido em
# api/leitura-semantica.js e api/verificar-imagem.js não foi verificado
# contra o projeto Vertex AI dele.
GEMINI_MODEL=

# Nome do modelo de IMAGEM do Gemini a usar (ex.: gemini-2.5-flash-image).
# Mesma ressalva do GEMINI_MODEL acima, para a fase 13 (geração das
# imagens) — o valor padrão embutido em api/gerar-imagem.js não foi
# verificado. CONFIRME antes de configurar em produção.
# ATENÇÃO: gemini-2.5-flash-image (o padrão embutido hoje) tem
# desligamento anunciado para 02/10/2026 — se essa data já passou quando
# você for configurar isto, confirme o modelo sucessor no Vertex AI antes
# de seguir, não assuma que o valor padrão ainda está disponível.
GEMINI_IMAGE_MODEL=
